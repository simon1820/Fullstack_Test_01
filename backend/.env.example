# =========================
# Backend environment example
# Copy this file to `backend/.env` and update values for your environment.
# Prisma uses `DATABASE_URL` by default. If you prefer granular DB_* vars,
# keep them but ensure your code or config converts them to a connection string.
# =========================

# Server
PORT=4000
NODE_ENV=development

# Public API URL (optional) — used by Swagger and logs. If your reverse proxy
# exposes the app under a different host or port, set this to the external URL.
# Example: API_URL=http://api.example.com/api
API_URL=http://localhost:4000/api
HOST=localhost

# Database (Prisma prefers a single DATABASE_URL)
# MySQL example:
DATABASE_URL="mysql://root:root@mysql:3306/gestorpro"

# Alternatively, granular values (if code uses them):
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gestorpro
DB_USER=root
DB_PASSWORD=password

# MongoDB alternative (uncomment if used)
# MONGODB_URI=mongodb://localhost:27017/gestorpro

# JWT / Auth
JWT_SECRET=change_this_jwt_secret_in_production
JWT_EXPIRES_IN=7d

# CORS (frontend origin)
CORS_ORIGIN=http://localhost:5173

# Rate limiting (optional)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging / Observability
LOG_LEVEL=info
